{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Serve Davao Food Finder",
            "type": "process",
            "command": "php",
            "args": [
                "-d",
                "extension=gd",
                "-S",
                "127.0.0.1:8080",
                "-t",
                "${workspaceFolder}/davao_food_finder"
            ],
            "options": {
                "cwd": "${workspaceFolder}/davao_food_finder"
            },
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": ".*"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*",
                    "endsPattern": "Development Server.*started"
                }
            }
        }
    ]
}
